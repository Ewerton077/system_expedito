@{
    ViewBag.Title = "Pagamentos";
    var pagos = ViewBag.Pagos as List<SantoExpedito.DTOs.VencimentoItemDto> ?? new();
    var pendentes = ViewBag.Pendentes as List<SantoExpedito.DTOs.VencimentoItemDto> ?? new();
    var fin = ViewBag.Financeiro as SantoExpedito.DTOs.FinanceiroDto ?? new();
    var totalPago = pagos.Sum(v => v.Valor);
    var totalPendente = pendentes.Sum(v => v.Valor);
}

<div class="page active" id="pagamentos">
    <div class="page-header"><h2>Pagamentos</h2></div>
    <div class="pag-menu">
        <button class="pag-menu-btn active" onclick="document.querySelectorAll('.pag-tab').forEach(t=>t.classList.remove('active'));document.getElementById('pagamentos-tab').classList.add('active');document.querySelectorAll('.pag-menu-btn').forEach(b=>b.classList.remove('active'));this.classList.add('active')">Pagamentos</button>
        <button class="pag-menu-btn" onclick="document.querySelectorAll('.pag-tab').forEach(t=>t.classList.remove('active'));document.getElementById('financeiro-tab').classList.add('active');document.querySelectorAll('.pag-menu-btn').forEach(b=>b.classList.remove('active'));this.classList.add('active')">Financeiro</button>
    </div>

    <div class="pag-tab active" id="pagamentos-tab">
        <div class="pag-summary">
            <div class="pag-summary-card"><div class="pag-summary-icon verde"><i class="ti ti-circle-check"></i></div><div class="pag-summary-info"><span>Efetuados</span><strong>@pagos.Count</strong></div></div>
            <div class="pag-summary-card"><div class="pag-summary-icon vermelho"><i class="ti ti-clock"></i></div><div class="pag-summary-info"><span>Pendentes</span><strong>@pendentes.Count</strong></div></div>
            <div class="pag-summary-card"><div class="pag-summary-icon verde"><i class="ti ti-coin"></i></div><div class="pag-summary-info"><span>Total Recebido</span><strong>R$ @totalPago.ToString("F2")</strong></div></div>
            <div class="pag-summary-card"><div class="pag-summary-icon amarelo"><i class="ti ti-alert-circle"></i></div><div class="pag-summary-info"><span>Total Pendente</span><strong>R$ @totalPendente.ToString("F2")</strong></div></div>
        </div>
        <div class="pag-grid">
            <div class="card">
                <div class="card-header"><h2><i class="ti ti-circle-check" style="color:var(--red)"></i> Efetuados</h2></div>
                <div class="pag-list">
                    @foreach (var v in pagos)
                    {
                        <div class="pag-item">
                            <div class="pag-item-icon pago"><i class="ti ti-circle-check"></i></div>
                            <div class="pag-item-info"><strong>@v.Cliente</strong><span>@v.Plano • Venceu @v.VencimentoData</span></div>
                            <span class="pag-item-value">R$ @v.Valor.ToString("F2")</span>
                        </div>
                    }
                </div>
            </div>
            <div class="card">
                <div class="card-header"><h2><i class="ti ti-clock" style="color:#C28A00"></i> Pendentes</h2></div>
                <div class="pag-list">
                    @foreach (var v in pendentes)
                    {
                        var hoje = DateTime.Now;
                        var partes = (v.VencimentoData ?? "").Split('/');
                        var dataVenStr = partes.Length == 3 ? $"{partes[2]}-{partes[1]}-{partes[0]}" : "";
                        DateTime.TryParse(dataVenStr, out var dataVen);
                        var diffT = (dataVen - hoje).Days;
                        var diasText = diffT > 0 ? $"{diffT} dia{(diffT > 1 ? "s" : "")} restante{(diffT > 1 ? "s" : "")}" : diffT == 0 ? "Vence hoje" : "Vencido";
                        var diffClass = diffT <= 0 ? "vencido" : diffT <= 3 ? "proximo" : "";
                        <div class="pag-item @diffClass">
                            <div class="pag-item-icon pendente"><i class="ti ti-clock"></i></div>
                            <div class="pag-item-info"><strong>@v.Cliente</strong><span>@v.Plano • Vence @v.VencimentoData (@diasText)</span></div>
                            <span class="pag-item-value">R$ @v.Valor.ToString("F2")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="pag-tab" id="financeiro-tab">
        <div class="pag-fin-summary">
            <div class="pag-summary-card"><div class="pag-summary-icon vermelho"><i class="ti ti-coin"></i></div><div class="pag-summary-info"><span>Receita Total</span><strong>R$ @fin.ReceitaTotal.ToString("F2")</strong></div></div>
            <div class="pag-summary-card"><div class="pag-summary-icon azul"><i class="ti ti-calendar"></i></div><div class="pag-summary-info"><span>Receita Mensal</span><strong>R$ @fin.ReceitaMensal.ToString("F2")</strong></div></div>
            <div class="pag-summary-card"><div class="pag-summary-icon amarelo"><i class="ti ti-calendar-time"></i></div><div class="pag-summary-info"><span>Receita Quinzenal</span><strong>R$ @fin.ReceitaQuinzenal.ToString("F2")</strong></div></div>
        </div>
        <div class="pag-fin-grid">
            <div class="card">
                <div class="card-header"><h2><i class="ti ti-pie-chart" style="color:var(--red)"></i> Distribuição dos Planos</h2></div>
                <div class="rel-chart-wrap"><canvas id="pagPlanosChart"></canvas></div>
            </div>
            <div class="card">
                <div class="card-header"><h2><i class="ti ti-chart-bar" style="color:var(--red)"></i> Receita por Plano</h2></div>
                <div class="rel-chart-wrap"><canvas id="pagReceitaChart"></canvas></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
new Chart(document.getElementById('pagPlanosChart'), {
    type: 'doughnut',
    data: { labels: ['Mensal', 'Quinzenal'], datasets: [{ data: [@fin.ClientesMensal, @fin.ClientesQuinzenal], backgroundColor: ['#E8321A', '#F5A89A'], borderWidth: 0 }] },
    options: { responsive: true, maintainAspectRatio: false, cutout: '60%', plugins: { legend: { position: 'right', labels: { color: '#4A4440', font: { size: 12 }, padding: 12, usePointStyle: true, pointStyle: 'circle' } } } }
});

new Chart(document.getElementById('pagReceitaChart'), {
    type: 'bar',
    data: { labels: ['Mensal', 'Quinzenal'], datasets: [{ label: 'Receita', data: [@fin.ReceitaMensal.ToString("F2"), @fin.ReceitaQuinzenal.ToString("F2")], backgroundColor: ['#E8321A', '#F5A89A'], borderRadius: 6, borderSkipped: false, maxBarThickness: 60 }] },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { color: '#A09890', callback: v => 'R$ ' + v.toFixed(2) }, grid: { color: 'rgba(0,0,0,.06)' } }, x: { ticks: { color: '#4A4440', font: { size: 12 } }, grid: { display: false } } } }
});
</script>
}
