@{
    ViewBag.Title = "Dashboard";
    var hojeAgendamentos = ViewBag.AgendamentosHoje as List<SantoExpedito.Models.Agendamento> ?? new();

    var hoje = DateTime.Now;
    var hojeStr = $"{hoje.Day:D2}/{hoje.Month:D2}/{hoje.Year}";
}

<div class="page active" id="dashboard">
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><i class="ti ti-users"></i></div>
            <div class="stat-info"><span>Clientes Ativos</span><h3>@ViewBag.TotalClientes</h3></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="ti ti-paw"></i></div>
            <div class="stat-info"><span>Pets Cadastrados</span><h3>@ViewBag.TotalPets</h3></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="ti ti-calendar"></i></div>
            <div class="stat-info"><span>Planos Mensais</span><h3>@ViewBag.PlanosMensais</h3></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="ti ti-calendar-time"></i></div>
            <div class="stat-info"><span>Planos Quinzenais</span><h3>@ViewBag.PlanosQuinzenais</h3></div>
        </div>
        <div class="stat-card danger">
            <div class="stat-icon"><i class="ti ti-alert-circle"></i></div>
            <div class="stat-info"><span>Pagamentos Atrasados</span><h3>@ViewBag.PagamentosAtrasados</h3></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="ti ti-calendar-event"></i></div>
            <div class="stat-info"><span>Vencem Hoje</span><h3>@ViewBag.PagamentosVencemHoje</h3></div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="card">
            <div class="card-header"><h2>Resumo de Planos</h2></div>
            <canvas id="plansChart"></canvas>
        </div>
        <div class="card">
            <div class="card-header"><h2>Pagamentos</h2></div>
            <canvas id="paymentsChart"></canvas>
        </div>
    </div>

    <div class="db-stats-card">
        <div class="db-stat">
            <i class="ti ti-database"></i>
            <div class="db-stat-info">
                <span>Banco de Dados</span>
                <strong>@ViewBag.DbSizeMb.ToString("F2") MB</strong>
            </div>
        </div>
        <div class="db-stat">
            <i class="ti ti-clock"></i>
            <div class="db-stat-info">
                <span>Tempo de Resposta</span>
                <strong>@ViewBag.DbResponseTimeMs ms</strong>
            </div>
        </div>
        <div class="db-stat">
            <i class="ti ti-server"></i>
            <div class="db-stat-info">
                <span>SQL Server</span>
                <strong>.\SQLEXPRESS</strong>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="card">
            <div class="card-header"><h2>Banhos Agendados Hoje (@hojeStr)</h2></div>
            <div class="banho-filters">
                <button class="banho-filter-btn active" onclick="filtrarBanhos('todos', this)">Todos (@hojeAgendamentos.Count)</button>
                <button class="banho-filter-btn espera" onclick="filtrarBanhos('Em espera', this)">Em espera (@hojeAgendamentos.Count(a => a.Status == "Em espera"))</button>
                <button class="banho-filter-btn processo" onclick="filtrarBanhos('Em processo', this)">Em processo (@hojeAgendamentos.Count(a => a.Status == "Em processo"))</button>
                <button class="banho-filter-btn concluido" onclick="filtrarBanhos('Concluído', this)">Concluído (@hojeAgendamentos.Count(a => a.Status == "Concluído"))</button>
            </div>
            <table id="tabelaBanhosHoje">
                <thead><tr><th>Horário</th><th>Pet</th><th>Tutor</th><th>Plano</th><th>Status</th></tr></thead>
                <tbody>
                    @if (hojeAgendamentos.Count == 0)
                    {
                        <tr><td colspan="5" style="text-align:center;padding:30px;color:var(--text-muted)">Nenhum banho pendente para hoje</td></tr>
                    }
                    @foreach (var a in hojeAgendamentos)
                    {
                        var statusClass = a.Status == "Em espera" ? "espera" : a.Status == "Em processo" ? "processo" : "concluido";
                        <tr data-status="@a.Status">
                            <td>@a.Horario</td>
                            <td>@a.Pet</td>
                            <td>@a.Tutor</td>
                            <td>@a.Plano</td>
                            <td><span class="agenda-list-status @statusClass">@a.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
<script>
function filtrarBanhos(status, btn) {
    document.querySelectorAll('.banho-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const rows = document.querySelectorAll('#tabelaBanhosHoje tbody tr');
    rows.forEach(row => {
        if (status === 'todos' || row.dataset.status === status) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}
new Chart(document.getElementById('plansChart'), {
    type: 'doughnut',
    data: {
        labels: ['Mensal', 'Quinzenal'],
        datasets: [{ data: [@ViewBag.PlanosMensais, @ViewBag.PlanosQuinzenais], backgroundColor: ['#E8321A', '#F5A89A'] }]
    },
    options: { responsive: true, cutout: '65%', plugins: { legend: { position: 'bottom', labels: { color: '#4A4440', font: { size: 13 }, padding: 16, usePointStyle: true, pointStyle: 'circle' } } } }
});

new Chart(document.getElementById('paymentsChart'), {
    type: 'bar',
    data: {
        labels: ['Pagos', 'Pendentes', 'Atrasados', 'Vencem Hoje'],
        datasets: [{ data: [@ViewBag.PagamentosPagos, @ViewBag.PagamentosPendentes, @ViewBag.PagamentosAtrasados, @ViewBag.PagamentosVencemHoje], backgroundColor: ['#E8321A', '#F5A89A', '#B82510', '#C28A00'], borderRadius: 6, borderSkipped: false, maxBarThickness: 50 }]
    },
    options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { color: '#A09890' }, grid: { color: 'rgba(0,0,0,.06)' } }, x: { ticks: { color: '#4A4440', font: { size: 12 } }, grid: { display: false } } } }
});
</script>
}
