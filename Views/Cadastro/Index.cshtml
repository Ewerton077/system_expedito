@{
    ViewBag.Title = "Cadastro de Cliente";
}
<link rel="stylesheet" href="~/css/forms.css">

<div class="page active">
    <div class="page-header"><h2>Cadastro de Cliente</h2></div>

    <form id="formCadastro">
        <div class="form-card">
            <div class="form-card-header"><i class="ti ti-user" style="color:var(--red);font-size:18px"></i><h2>Dados do Responsável</h2></div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-group full">
                        <label for="campoNome">Nome Completo</label>
                        <input type="text" id="campoNome" class="form-control" placeholder="Nome do responsável" required>
                    </div>
                    <div class="form-group">
                        <label for="campoCpf">CPF</label>
                        <input type="text" id="campoCpf" class="form-control" placeholder="000.000.000-00" maxlength="14" required>
                        <span class="cpf-feedback" id="cpfFeedback"></span>
                    </div>
                    <div class="form-group">
                        <label for="campoCelular">Celular</label>
                        <input type="tel" id="campoCelular" class="form-control" placeholder="(11) 99999-0000" required>
                    </div>
                    <div class="form-group">
                        <label for="campoRua">Endereço (Rua)</label>
                        <input type="text" id="campoRua" class="form-control" placeholder="Rua, Avenida..." required>
                    </div>
                    <div class="form-group">
                        <label for="campoNumero">Número</label>
                        <input type="text" id="campoNumero" class="form-control" placeholder="Nº" required>
                    </div>
                    <div class="form-group">
                        <label for="campoCep">CEP</label>
                        <input type="text" id="campoCep" class="form-control" placeholder="00000-000" maxlength="9">
                    </div>
                    <div class="form-group full">
                        <label for="campoEmail">E-mail <span class="label-optional">(opcional)</span></label>
                        <input type="email" id="campoEmail" class="form-control" placeholder="cliente@exemplo.com">
                    </div>
                </div>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header"><i class="ti ti-paw" style="color:var(--red);font-size:18px"></i><h2>Dados do Pet</h2></div>
            <div class="form-card-body">
                <div id="petsContainer">
                    <div class="pet-entry" data-pet-index="0">
                        <div class="pet-entry-header"><h3><i class="ti ti-paw" style="color:var(--red)"></i> 1º Pet</h3></div>
                        <div class="form-grid">
                            <div class="form-group"><label>Nome do Pet</label><input type="text" class="form-control pet-nome" placeholder="Nome do pet" required></div>
                            <div class="form-group"><label>Idade</label><input type="text" class="form-control pet-idade" placeholder="Ex: 2 anos" required></div>
                            <div class="form-group full">
                                <label>Raça</label>
                                <select class="form-control pet-raca" required>
                                    <option value="">Selecione a raça</option>
                                    <option value="Vira-lata">Vira-lata (SRD)</option>
                                    <option value="Akita">Akita</option>
                                    <option value="Beagle">Beagle</option>
                                    <option value="Border Collie">Border Collie</option>
                                    <option value="Boxer">Boxer</option>
                                    <option value="Buldogue Francês">Buldogue Francês</option>
                                    <option value="Buldogue Inglês">Buldogue Inglês</option>
                                    <option value="Chihuahua">Chihuahua</option>
                                    <option value="Dachshund (Teckel/Salsicha)">Dachshund (Teckel/Salsicha)</option>
                                    <option value="Dobermann">Dobermann</option>
                                    <option value="Dogue Alemão">Dogue Alemão</option>
                                    <option value="Fila Brasileiro">Fila Brasileiro</option>
                                    <option value="Golden Retriever">Golden Retriever</option>
                                    <option value="Husky Siberiano">Husky Siberiano</option>
                                    <option value="Labrador Retriever">Labrador Retriever</option>
                                    <option value="Lhasa Apso">Lhasa Apso</option>
                                    <option value="Maltês">Maltês</option>
                                    <option value="Pastor Alemão">Pastor Alemão</option>
                                    <option value="Pit Bull">Pit Bull</option>
                                    <option value="Poodle">Poodle</option>
                                    <option value="Pug">Pug</option>
                                    <option value="Rottweiler">Rottweiler</option>
                                    <option value="Shiba Inu">Shiba Inu</option>
                                    <option value="Shih Tzu">Shih Tzu</option>
                                    <option value="Yorkshire Terrier">Yorkshire Terrier</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Porte</label>
                                <select class="form-control pet-porte" required>
                                    <option value="">Selecione</option>
                                    <option value="Pequeno">Pequeno</option>
                                    <option value="Médio">Médio</option>
                                    <option value="Grande">Grande</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group full"><label>Ração que consome</label><input type="text" class="form-control pet-racao" placeholder="Ex: Golden Special, Premier..." required></div>
                        <div class="form-group full">
                            <label>Consome medicamento?</label>
                            <div class="radio-group">
                                <label class="radio-label"><input type="radio" name="medicamento" class="pet-medicamento" value="sim"><i class="ti ti-circle-check"></i> Sim</label>
                                <label class="radio-label"><input type="radio" name="medicamento" class="pet-medicamento" value="nao" checked><i class="ti ti-circle-x"></i> Não</label>
                            </div>
                            <input type="text" class="form-control pet-medicamento-nome" placeholder="Nome do medicamento" style="display:none;margin-top:8px">
                        </div>
                        <div class="form-group datepicker-group">
                            <label>Última Vermifugação <span class="label-optional">(opcional)</span></label>
                            <div class="datepicker-wrapper">
                                <input type="text" class="form-control pet-vermifugacao datepicker-input" placeholder="Selecione a data" readonly>
                                <button type="button" class="datepicker-trigger" tabindex="-1"><i class="ti ti-calendar"></i></button>
                                <div class="datepicker-popup" style="display:none"></div>
                            </div>
                        </div>
                        <div class="form-group datepicker-group">
                            <label>Última Antipulgas <span class="label-optional">(opcional)</span></label>
                            <div class="datepicker-wrapper">
                                <input type="text" class="form-control pet-antipulgas datepicker-input" placeholder="Selecione a data" readonly>
                                <button type="button" class="datepicker-trigger" tabindex="-1"><i class="ti ti-calendar"></i></button>
                                <div class="datepicker-popup" style="display:none"></div>
                            </div>
                        </div>
                        <div class="form-group full datepicker-group">
                            <label>Última Vacinação <span class="label-optional">(opcional)</span></label>
                            <div class="datepicker-wrapper">
                                <input type="text" class="form-control pet-vacinacao datepicker-input" placeholder="Selecione a data" readonly>
                                <button type="button" class="datepicker-trigger" tabindex="-1"><i class="ti ti-calendar"></i></button>
                                <div class="datepicker-popup" style="display:none"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-add-pet" id="btnAdicionarPet"><i class="ti ti-plus"></i> Adicionar outro pet</button>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-header"><i class="ti ti-file-text" style="color:var(--red);font-size:18px"></i><h2>Plano</h2></div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Tipo de Plano</label>
                        <div class="radio-group">
                            <label class="radio-label"><input type="radio" name="plano" value="Mensal" checked><i class="ti ti-calendar"></i> Mensal</label>
                            <label class="radio-label"><input type="radio" name="plano" value="Quinzenal"><i class="ti ti-calendar-time"></i> Quinzenal</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Incluir Taxidog?</label>
                        <div class="radio-group">
                            <label class="radio-label"><input type="radio" name="taxidog" value="sim" checked><i class="ti ti-circle-check"></i> Sim</label>
                            <label class="radio-label"><input type="radio" name="taxidog" value="nao"><i class="ti ti-circle-x"></i> Não</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Incluir Tosa?</label>
                        <div class="radio-group">
                            <label class="radio-label"><input type="radio" name="tosa" value="sim" checked><i class="ti ti-circle-check"></i> Sim</label>
                            <label class="radio-label"><input type="radio" name="tosa" value="nao"><i class="ti ti-circle-x"></i> Não</label>
                        </div>
                    </div>
                    <div class="form-group full">
                        <label for="campoValor">Valor do Plano (R$)</label>
                        <input type="number" id="campoValor" class="form-control" step="0.01" min="0" required>
                    </div>
                    <div class="form-group full">
                        <label>Calendário de Banhos</label>
                        <span class="field-hint">Clique nas datas para marcar os dias de banho deste mês</span>
                        <div class="mini-calendar" id="miniCalendarCadastro">
                            <div class="mini-cal-header">
                                <button type="button" class="mini-cal-nav" id="miniCalPrev"><i class="ti ti-chevron-left"></i></button>
                                <span class="mini-cal-title" id="miniCalTitle"></span>
                                <button type="button" class="mini-cal-nav" id="miniCalNext"><i class="ti ti-chevron-right"></i></button>
                            </div>
                            <div class="mini-cal-dias-semana"><span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span></div>
                            <div class="mini-cal-grid" id="miniCalGrid"></div>
                        </div>
                        <div class="mini-cal-info" id="miniCalInfo">Selecione até <strong>4</strong> datas</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="reset" class="btn-secondary"><i class="ti ti-refresh"></i> Limpar</button>
            <button type="submit" class="btn-primary" id="btnSalvar"><i class="ti ti-device-floppy"></i> Salvar Cadastro</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
let petCount = 1;
function mascaraCPF(valor) {
    const digits = valor.replace(/\D/g, '').slice(0, 11);
    let formatted = '';
    for (let i = 0; i < digits.length; i++) {
        if (i === 3 || i === 6) formatted += '.';
        if (i === 9) formatted += '-';
        formatted += digits[i];
    }
    return formatted;
}
function validarCPF(cpf) {
    const digits = cpf.replace(/\D/g, '');
    if (digits.length !== 11) return false;
    if (/^(\d)\1{10}$/.test(digits)) return false;
    let sum = 0;
    for (let i = 0; i < 9; i++) sum += parseInt(digits[i]) * (10 - i);
    let rest = (sum * 10) % 11;
    if (rest === 10) rest = 0;
    if (rest !== parseInt(digits[9])) return false;
    sum = 0;
    for (let i = 0; i < 10; i++) sum += parseInt(digits[i]) * (11 - i);
    rest = (sum * 10) % 11;
    if (rest === 10) rest = 0;
    return rest === parseInt(digits[10]);
}
const campoCpf = document.getElementById('campoCpf');
const cpfFeedback = document.getElementById('cpfFeedback');
campoCpf.addEventListener('input', () => {
    const masked = mascaraCPF(campoCpf.value);
    campoCpf.value = masked;
    const digits = masked.replace(/\D/g, '');
    if (digits.length < 11) { campoCpf.className = 'form-control'; cpfFeedback.textContent = ''; return; }
    if (validarCPF(masked)) { campoCpf.className = 'form-control is-valid'; cpfFeedback.textContent = 'CPF válido'; cpfFeedback.className = 'cpf-feedback success'; }
    else { campoCpf.className = 'form-control is-invalid'; cpfFeedback.textContent = 'CPF inválido'; cpfFeedback.className = 'cpf-feedback error'; }
});
document.getElementById('btnAdicionarPet').addEventListener('click', () => {
    const container = document.getElementById('petsContainer');
    petCount++;
    const div = document.createElement('div');
    div.className = 'pet-entry';
    div.dataset.petIndex = petCount - 1;
    div.innerHTML = `<div class="pet-entry-header"><h3><i class="ti ti-paw" style="color:var(--red)"></i> ${petCount}º Pet</h3><button type="button" class="btn-remove-pet" title="Remover pet"><i class="ti ti-x"></i></button></div>
        <div class="form-grid">
            <div class="form-group"><label>Nome do Pet</label><input type="text" class="form-control pet-nome" placeholder="Nome do pet" required></div>
            <div class="form-group"><label>Idade</label><input type="text" class="form-control pet-idade" placeholder="Ex: 2 anos" required></div>
            <div class="form-group full"><label>Raça</label><select class="form-control pet-raca" required>${document.querySelector('.pet-raca').innerHTML}</select></div>
            <div class="form-group"><label>Porte</label><select class="form-control pet-porte" required>${document.querySelector('.pet-porte').innerHTML}</select></div>
        </div>
        <div class="form-group full"><label>Ração que consome</label><input type="text" class="form-control pet-racao" placeholder="Ex: Golden Special, Premier..." required></div>
        <div class="form-group full">
            <label>Consome medicamento?</label>
            <div class="radio-group">
                <label class="radio-label"><input type="radio" class="pet-medicamento" value="sim"><i class="ti ti-circle-check"></i> Sim</label>
                <label class="radio-label"><input type="radio" class="pet-medicamento" value="nao" checked><i class="ti ti-circle-x"></i> Não</label>
            </div>
            <input type="text" class="form-control pet-medicamento-nome" placeholder="Nome do medicamento" style="display:none;margin-top:8px">
        </div>
        <div class="form-group datepicker-group">
            <label>Última Vermifugação <span class="label-optional">(opcional)</span></label>
            <div class="datepicker-wrapper">
                <input type="text" class="form-control pet-vermifugacao datepicker-input" placeholder="Selecione a data" readonly>
                <button type="button" class="datepicker-trigger" tabindex="-1"><i class="ti ti-calendar"></i></button>
                <div class="datepicker-popup" style="display:none"></div>
            </div>
        </div>
        <div class="form-group datepicker-group">
            <label>Última Antipulgas <span class="label-optional">(opcional)</span></label>
            <div class="datepicker-wrapper">
                <input type="text" class="form-control pet-antipulgas datepicker-input" placeholder="Selecione a data" readonly>
                <button type="button" class="datepicker-trigger" tabindex="-1"><i class="ti ti-calendar"></i></button>
                <div class="datepicker-popup" style="display:none"></div>
            </div>
        </div>
        <div class="form-group full datepicker-group">
            <label>Última Vacinação <span class="label-optional">(opcional)</span></label>
            <div class="datepicker-wrapper">
                <input type="text" class="form-control pet-vacinacao datepicker-input" placeholder="Selecione a data" readonly>
                <button type="button" class="datepicker-trigger" tabindex="-1"><i class="ti ti-calendar"></i></button>
                <div class="datepicker-popup" style="display:none"></div>
            </div>
        </div>`;
    initDatepickers(div);
    div.querySelector('.btn-remove-pet').addEventListener('click', () => { div.remove(); reindexPets(); });
    container.appendChild(div);
});
function reindexPets() {
    const entries = document.querySelectorAll('.pet-entry');
    entries.forEach((el, i) => { el.dataset.petIndex = i; el.querySelector('h3').innerHTML = `<i class="ti ti-paw" style="color:var(--red)"></i> ${i + 1}º Pet`; });
    petCount = entries.length;
}
document.getElementById('campoValor').value = '180.00';
document.querySelectorAll('input[name="plano"]').forEach(radio => {
    radio.addEventListener('change', () => {
        const campoValor = document.getElementById('campoValor');
        if (campoValor && !campoValor.dataset.custom) campoValor.value = radio.value === 'Mensal' ? '180.00' : '110.00';
    });
});
document.getElementById('campoValor').addEventListener('input', function() { if (this.value) this.dataset.custom = 'true'; else delete this.dataset.custom; });

let miniCalMes = new Date().getMonth();
let miniCalAno = new Date().getFullYear();
let datasBanhoSelecionadas = [];
function getMaxDatasBanho() { const p = document.querySelector('input[name="plano"]:checked'); return p && p.value === 'Mensal' ? 4 : 2; }
function renderizarMiniCalendario() {
    const grid = document.getElementById('miniCalGrid');
    const title = document.getElementById('miniCalTitle');
    const info = document.getElementById('miniCalInfo');
    if (!grid || !title) return;
    const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
    title.textContent = `${meses[miniCalMes]} ${miniCalAno}`;
    const maxDatas = getMaxDatasBanho();
    info.innerHTML = `Selecione até <strong>${maxDatas}</strong> data${maxDatas > 1 ? 's' : ''} (${datasBanhoSelecionadas.length}/${maxDatas})`;
    const primeiroDia = new Date(miniCalAno, miniCalMes, 1).getDay();
    const ultimoDia = new Date(miniCalAno, miniCalMes + 1, 0).getDate();
    const ultimoDiaMesAnt = new Date(miniCalAno, miniCalMes, 0).getDate();
    let html = '';
    for (let i = primeiroDia - 1; i >= 0; i--) html += `<button type="button" class="mini-cal-dia outro-mes" disabled>${ultimoDiaMesAnt - i}</button>`;
    for (let d = 1; d <= ultimoDia; d++) {
        const dataStr = `${String(d).padStart(2,'0')}/${String(miniCalMes+1).padStart(2,'0')}/${miniCalAno}`;
        const selected = datasBanhoSelecionadas.includes(dataStr) ? 'selected' : '';
        const isDisabled = datasBanhoSelecionadas.length >= maxDatas && !datasBanhoSelecionadas.includes(dataStr) ? 'disabled' : '';
        html += `<button type="button" class="mini-cal-dia ${selected} ${isDisabled}" data-data="${dataStr}" ${isDisabled}>${d}</button>`;
    }
    const resto = (7 - ((primeiroDia + ultimoDia) % 7)) % 7;
    for (let d = 1; d <= resto; d++) html += `<button type="button" class="mini-cal-dia outro-mes" disabled>${d}</button>`;
    grid.innerHTML = html;
    grid.querySelectorAll('.mini-cal-dia:not(.outro-mes)').forEach(btn => {
        btn.addEventListener('click', () => {
            const dataStr = btn.dataset.data;
            const idx = datasBanhoSelecionadas.indexOf(dataStr);
            if (idx !== -1) datasBanhoSelecionadas.splice(idx, 1);
            else if (datasBanhoSelecionadas.length < getMaxDatasBanho()) datasBanhoSelecionadas.push(dataStr);
            renderizarMiniCalendario();
        });
    });
}
document.getElementById('miniCalPrev').addEventListener('click', e => { e.preventDefault(); miniCalMes--; if (miniCalMes < 0) { miniCalMes = 11; miniCalAno--; } renderizarMiniCalendario(); });
document.getElementById('miniCalNext').addEventListener('click', e => { e.preventDefault(); miniCalMes++; if (miniCalMes > 11) { miniCalMes = 0; miniCalAno++; } renderizarMiniCalendario(); });
document.querySelectorAll('input[name="plano"]').forEach(radio => radio.addEventListener('change', () => { if (datasBanhoSelecionadas.length > getMaxDatasBanho()) datasBanhoSelecionadas = datasBanhoSelecionadas.slice(0, getMaxDatasBanho()); renderizarMiniCalendario(); }));
renderizarMiniCalendario();

function initDatepickers(container) {
    container.querySelectorAll('.datepicker-wrapper').forEach(wrapper => {
        const input = wrapper.querySelector('.datepicker-input');
        const trigger = wrapper.querySelector('.datepicker-trigger');
        const popup = wrapper.querySelector('.datepicker-popup');
        let calMes = new Date().getMonth();
        let calAno = new Date().getFullYear();
        let selectedDate = input.value || '';

        function renderDatepicker() {
            const meses = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
            const primeiroDia = new Date(calAno, calMes, 1).getDay();
            const ultimoDia = new Date(calAno, calMes + 1, 0).getDate();
            const ultimoDiaMesAnt = new Date(calAno, calMes, 0).getDate();
            let html = `<div class="dp-header">
                <button type="button" class="dp-nav" data-dir="-1"><i class="ti ti-chevron-left"></i></button>
                <span class="dp-title">${meses[calMes]} ${calAno}</span>
                <button type="button" class="dp-nav" data-dir="1"><i class="ti ti-chevron-right"></i></button>
            </div>
            <div class="dp-dias-semana"><span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span></div>
            <div class="dp-grid">`;
            for (let i = primeiroDia - 1; i >= 0; i--) html += `<button type="button" class="dp-dia outro-mes" disabled>${ultimoDiaMesAnt - i}</button>`;
            for (let d = 1; d <= ultimoDia; d++) {
                const dataStr = `${String(d).padStart(2,'0')}/${String(calMes+1).padStart(2,'0')}/${calAno}`;
                const isSelected = selectedDate === dataStr ? 'selected' : '';
                html += `<button type="button" class="dp-dia ${isSelected}" data-val="${dataStr}">${d}</button>`;
            }
            const resto = (7 - ((primeiroDia + ultimoDia) % 7)) % 7;
            for (let d = 1; d <= resto; d++) html += `<button type="button" class="dp-dia outro-mes" disabled>${d}</button>`;
            html += `</div>`;
            html += `<div class="dp-footer"><button type="button" class="dp-limpar">Limpar</button></div>`;
            popup.innerHTML = html;

            popup.querySelectorAll('.dp-nav').forEach(btn => {
                btn.addEventListener('click', e => {
                    e.stopPropagation();
                    const dir = parseInt(btn.dataset.dir);
                    calMes += dir;
                    if (calMes < 0) { calMes = 11; calAno--; }
                    if (calMes > 11) { calMes = 0; calAno++; }
                    renderDatepicker();
                });
            });
            popup.querySelectorAll('.dp-dia:not(.outro-mes)').forEach(btn => {
                btn.addEventListener('click', e => {
                    e.stopPropagation();
                    selectedDate = btn.dataset.val;
                    input.value = selectedDate;
                    popup.style.display = 'none';
                });
            });
            const limpar = popup.querySelector('.dp-limpar');
            if (limpar) {
                limpar.addEventListener('click', e => {
                    e.stopPropagation();
                    selectedDate = '';
                    input.value = '';
                    popup.style.display = 'none';
                });
            }
        }

        function openDatepicker() {
            if (input.value) {
                const parts = input.value.split('/');
                if (parts.length === 3) {
                    calMes = parseInt(parts[1]) - 1;
                    calAno = parseInt(parts[2]);
                }
            }
            selectedDate = input.value;
            renderDatepicker();
            popup.style.display = 'block';
        }

        function closeDatepicker() {
            popup.style.display = 'none';
        }

        input.addEventListener('click', e => { e.stopPropagation(); openDatepicker(); });
        trigger.addEventListener('click', e => { e.stopPropagation(); openDatepicker(); });
        document.addEventListener('click', e => {
            if (!wrapper.contains(e.target)) closeDatepicker();
        });
    });
}
initDatepickers(document);

document.addEventListener('change', e => {
    if (e.target.classList.contains('pet-medicamento')) {
        const container = e.target.closest('.pet-entry') || document;
        const nomeField = container.querySelector('.pet-medicamento-nome');
        if (nomeField) nomeField.style.display = e.target.value === 'sim' ? 'block' : 'none';
    }
});

document.getElementById('formCadastro').addEventListener('submit', e => {
    e.preventDefault();
    const campoValor = document.getElementById('campoValor');
    if (!campoValor.value || parseFloat(campoValor.value) <= 0) { alert('Defina o valor do plano.'); campoValor.focus(); return; }
    const nome = document.getElementById('campoNome').value.trim();
    const cpf = document.getElementById('campoCpf').value.trim();
    const celular = document.getElementById('campoCelular').value.trim();
    const rua = document.getElementById('campoRua').value.trim();
    const numero = document.getElementById('campoNumero').value.trim();
    const email = document.getElementById('campoEmail').value.trim();
    const cep = document.getElementById('campoCep').value.trim();
    if (!nome || !cpf || !celular || !rua || !numero) { alert('Preencha todos os campos obrigatórios.'); return; }
    if (!validarCPF(cpf)) { alert('CPF inválido.'); document.getElementById('campoCpf').focus(); return; }
    const pets = [];
    document.querySelectorAll('.pet-entry').forEach(el => {
        const petNome = el.querySelector('.pet-nome').value.trim();
        const petIdade = el.querySelector('.pet-idade').value.trim();
        const petRaca = el.querySelector('.pet-raca').value;
        const petRacao = el.querySelector('.pet-racao')?.value.trim() || '';
        const petPorte = el.querySelector('.pet-porte')?.value || '';
        const petVermifugacao = el.querySelector('.pet-vermifugacao')?.value || '';
        const petAntipulgas = el.querySelector('.pet-antipulgas')?.value || '';
        const petVacinacao = el.querySelector('.pet-vacinacao')?.value || '';
        const petMedicamento = el.querySelector('.pet-medicamento:checked')?.value || 'nao';
        const petMedicamentoNome = el.querySelector('.pet-medicamento-nome')?.value || '';
        if (petNome && petIdade && petRaca && petPorte) pets.push({ nome: petNome, idade: petIdade, raca: petRaca, porte: petPorte, racao: petRacao, vermifugacao: petVermifugacao, antipulgas: petAntipulgas, vacinacao: petVacinacao, medicamento: petMedicamento, medicamentoNome: petMedicamentoNome });
    });
    if (pets.length === 0) { alert('Adicione ao menos um pet.'); return; }
    const plano = document.querySelector('input[name="plano"]:checked').value;
    const taxidog = document.querySelector('input[name="taxidog"]:checked').value;
    const tosa = document.querySelector('input[name="tosa"]:checked').value;
    const dados = { responsavel: { nome, cpf, celular, endereco: `${rua}, ${numero}`, email, cep }, pets, plano, taxidog, tosa, valor: parseFloat(campoValor.value), datasBanho: [...datasBanhoSelecionadas] };
    fetch('@Url.Action("Salvar","Cadastro")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(dados)
    }).then(r => r.json()).then(data => { alert(data.message || 'Cliente cadastrado com sucesso!'); window.location.href = '@Url.Action("Index","Clientes")'; }).catch(() => { alert('Erro ao cadastrar.'); });
});
</script>
}
